# GHCR 이미지 태그: deploy 브랜치의 latest, 버전 또는 sha-xxxxxxx
IMAGE_TAG=latest
APP_BIND=127.0.0.1
APP_PORT=8085
CLOUD_NETWORK_NAME=befw-cloud-network

# ayaan이 POST /api/v1/notify 호출 시 사용하는 비밀값 (X-ECC-Token)
ECC_API_TOKEN=replace-with-long-random-secret
# BotFather 발급 토큰
ECC_TELEGRAM_BOT_TOKEN=
# 허용 Telegram 숫자 사용자 ID 목록(쉼표 구분)
ECC_TELEGRAM_ALLOWED_USER_IDS=

# ayaan API (게이트웨이 경유) 및 X-AYAAN-Token 값
ECC_AYAAN_BASE_URL=http://gateway-cloud-gateway-1:10001/tsh/api/v1/ayaan
ECC_AYAAN_TOKEN=
