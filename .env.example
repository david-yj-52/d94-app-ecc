# Image tag from GHCR: latest (deploy branch), semantic version, or sha-xxxxxxx
IMAGE_TAG=latest
APP_BIND=127.0.0.1
APP_PORT=8085
CLOUD_NETWORK_NAME=befw-cloud-network

# Bind-mounted paths on the Docker host. Expose only workspaces intended for ECC.
WORKSPACE_HOST_PATH=./workspace
CLI_AUTH_HOST_PATH=./cli-auth

# Required secret for REST API callers. Generate a long random value.
ECC_API_TOKEN=replace-with-long-random-secret
ECC_REDIS_URL=redis://redis:6379/0
ECC_TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to submit/approve.
ECC_TELEGRAM_ALLOWED_USER_IDS=
ECC_TELEGRAM_DEFAULT_WORKSPACE=/workspace

# Nano classifier; empty enables the deterministic fallback plan.
ECC_NANO_ENDPOINT=
ECC_NANO_TIMEOUT_SECONDS=30

# Eureka registration is optional; enable when the container shares the Eureka network.
ECC_EUREKA_ENABLED=false
ECC_EUREKA_URL=http://eureka-cloud-eureka-1:8761/eureka/
ECC_EUREKA_INSTANCE_HOSTNAME=d94-ecc
ECC_EUREKA_INSTANCE_IP=

ECC_CLI_ALLOWLIST=claude,gemini,codex
ECC_CLI_TIMEOUT_SECONDS=1800
ECC_CLI_WORKSPACES=/workspace
# Executables must exist inside the ECC container and be executable by UID 10001.
ECC_CLI_EXECUTABLES=claude=/usr/local/bin/claude,gemini=/usr/local/bin/gemini,codex=/usr/local/bin/codex
ECC_TICKET_TTL_SECONDS=604800

